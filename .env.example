# Which LLM answers questions:
#   ollama    — free, runs locally (default). Install: brew install ollama && ollama pull qwen2.5:7b
#   anthropic — Claude API, needs a key from https://console.anthropic.com
LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_HOST=http://localhost:11434      # from inside Docker: http://host.docker.internal:11434

ANTHROPIC_API_KEY=
# RELEASEWISE_MODEL=claude-opus-5
